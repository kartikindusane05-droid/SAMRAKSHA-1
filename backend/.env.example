PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# SECURITY: Set this to your specific frontend origin. Never use '*' in production.
# Example: CLIENT_ORIGIN=https://samraksha.app
CLIENT_ORIGIN=http://localhost:3000

# SECURITY: Replace with a strong random secret before deploying.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_BEFORE_DEPLOY

# ── PostgreSQL Database Configuration ──────────────────────
# Provide either individual PG_* connection parameters or a full DATABASE_URL.
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=samraksha_db
PG_USER=postgres
PG_PASSWORD=your_postgres_password_here
# Optional: DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/samraksha_db
PG_MAX_POOL=20
