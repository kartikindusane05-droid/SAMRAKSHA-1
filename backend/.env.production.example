# SAMRAKSHA Production Environment Configuration Template
# For Render, these are automatically managed via render.yaml or the Render Dashboard.
# Never commit actual secret values into version control.

NODE_ENV=production
PORT=10000
HOST=0.0.0.0

# Managed PostgreSQL Connection String (provided automatically by Render / Neon / Supabase)
DATABASE_URL=postgresql://samraksha_user:<DATABASE_PASSWORD>@<DB_HOST>/samraksha_db?sslmode=require

# CORS Policy: '*' allows mobile apps and web clients, or specify comma-separated domains
CLIENT_ORIGIN=*

# Cryptographically strong secrets (auto-generated by Render or minimum 32 random hex characters)
JWT_SECRET=<GENERATE_STRONG_RANDOM_SECRET_32_HEX>
ADMIN_API_KEY=<GENERATE_STRONG_RANDOM_ADMIN_KEY_32_HEX>

# Optional Connection Pool Tuning
PG_MAX_POOL=20
